{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Samwise-x/opencode-actions/schemas/evidence-v1.schema.json",
  "title": "OpenCode Actions Evidence v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "attempt_id", "base_sha", "status", "opencode_exit", "started_at", "ended_at"],
  "properties": {
    "schema": { "const": 1 },
    "attempt_id": { "type": "string", "minLength": 3 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_branch": { "type": "string" },
    "model": { "type": "string" },
    "agent": { "type": "string" },
    "status": { "enum": ["opencode_failed", "validation_failed", "validated"] },
    "opencode_exit": { "type": "integer" },
    "validation_exit": { "type": "integer" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" }
  }
}
