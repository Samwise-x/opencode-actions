{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"OpenCode Candidate Evidence",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","trajectory_id","trajectory_version","attempt_id","github_run_id","base_sha","candidate_sha","validation"],
  "properties":{
    "schema_version":{"const":1},
    "trajectory_id":{"type":"string","minLength":1},
    "trajectory_version":{"type":"integer","minimum":0},
    "attempt_id":{"type":"string","minLength":1},
    "github_run_id":{"type":"string","pattern":"^[0-9]+$"},
    "base_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "candidate_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "opencode_session_id":{"type":["string","null"]},
    "model":{"type":["string","null"]},
    "validation":{"type":"object","additionalProperties":false,"required":["status","command"],"properties":{"status":{"enum":["passed","failed"]},"command":{"type":"string","minLength":1}}}
  }
}
