#!/usr/bin/env python3
import json, os, subprocess, sys
from pathlib import Path

if len(sys.argv) != 3:
    raise SystemExit("usage: admit <manifest.json> <canonical-ref>")
manifest=json.loads(Path(sys.argv[1]).read_text())
canonical=sys.argv[2]
subprocess.run([".automation/bin/validate-evidence",sys.argv[1]],check=True)
expected=manifest["base_sha"]
candidate=manifest["candidate_sha"]
remote=subprocess.check_output(["git","ls-remote","origin",f"refs/heads/{canonical}"],text=True).split()[0]
if remote != expected:
    raise SystemExit(f"STALE: canonical {remote} != expected {expected}")
# --force-with-lease is a compare-and-swap guard: update only if the remote still equals expected.
subprocess.run([
    "git","push","origin",
    f"{candidate}:refs/heads/{canonical}",
    f"--force-with-lease=refs/heads/{canonical}:{expected}"
],check=True)
print(f"admitted {candidate} to {canonical}")
