#!/usr/bin/env python3
import json, os, subprocess, sys
from pathlib import Path

if len(sys.argv) != 3:
    raise SystemExit("usage: make-evidence <base-sha> <validation-command>")
base, command=sys.argv[1],sys.argv[2]
candidate=subprocess.check_output(["git","rev-parse","HEAD"],text=True).strip()
out={
 "schema_version":1,
 "trajectory_id":os.environ["TRAJECTORY_ID"],
 "trajectory_version":int(os.environ.get("TRAJECTORY_VERSION","0")),
 "attempt_id":os.environ["ATTEMPT_ID"],
 "github_run_id":os.environ["GITHUB_RUN_ID"],
 "base_sha":base,
 "candidate_sha":candidate,
 "opencode_session_id":os.environ.get("OPENCODE_SESSION_ID"),
 "model":os.environ.get("OPENCODE_MODEL"),
 "validation":{"status":"passed","command":command}
}
Path(".automation/evidence.json").write_text(json.dumps(out,indent=2)+"\n")
print(candidate)
